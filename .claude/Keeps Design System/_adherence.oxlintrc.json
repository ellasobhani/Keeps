{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/feed/**",
              "components/forms/**",
              "components/navigation/**",
              "components/social/**",
              "ui_kits/keeps-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|displayName|size|key|ref|className|style|children)$/]",
        "message": "<Avatar> doesn't accept that prop. Declared props: src, displayName, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomNavBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|onNavigate|key|ref|className|style|children)$/]",
        "message": "<BottomNavBar> doesn't accept that prop. Declared props: active, onNavigate."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomNavBar'] > JSXAttribute[name.name='active'] > Literal[value!=/^(?:profile|feed|search)$/]",
        "message": "<BottomNavBar> active must be one of 'profile' | 'feed' | 'search'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|variant|disabled|loading|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: label, variant, disabled, loading, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|text|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'text' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CarouselChevron'] > JSXAttribute > JSXIdentifier[name!=/^(?:direction|key|ref|className|style|children)$/]",
        "message": "<CarouselChevron> doesn't accept that prop. Declared props: direction."
      },
      {
        "selector": "JSXOpeningElement[name.name='CarouselChevron'] > JSXAttribute[name.name='direction'] > Literal[value!=/^(?:left|right)$/]",
        "message": "<CarouselChevron> direction must be one of 'left' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CommentComposer'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|onSubmit|placeholder|key|ref|className|style|children)$/]",
        "message": "<CommentComposer> doesn't accept that prop. Declared props: value, onChange, onSubmit, placeholder."
      },
      {
        "selector": "JSXOpeningElement[name.name='CommentThreadItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:author|body|key|ref|className|style|children)$/]",
        "message": "<CommentThreadItem> doesn't accept that prop. Declared props: author, body."
      },
      {
        "selector": "JSXOpeningElement[name.name='CoverPhotoPicker'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|onClick|key|ref|className|style|children)$/]",
        "message": "<CoverPhotoPicker> doesn't accept that prop. Declared props: src, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|size|variant|color|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, size, variant, color, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:solid|plain)$/]",
        "message": "<IconButton> variant must be one of 'solid' | 'plain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='KeepCoverCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|coverSrc|isPrivate|hiddenFromProfile|onClick|key|ref|className|style|children)$/]",
        "message": "<KeepCoverCard> doesn't accept that prop. Declared props: title, coverSrc, isPrivate, hiddenFromProfile, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='LikeRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:likedByNames|hasLiked|isFavorited|onToggleLike|onToggleFavorite|onNameClick|key|ref|className|style|children)$/]",
        "message": "<LikeRow> doesn't accept that prop. Declared props: likedByNames, hasLiked, isFavorited, onToggleLike, onToggleFavorite, onNameClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='PostGridTile'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|mediaCount|isVideo|onClick|key|ref|className|style|children)$/]",
        "message": "<PostGridTile> doesn't accept that prop. Declared props: src, mediaCount, isVideo, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='SideMenuItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|icon|onClick|key|ref|className|style|children)$/]",
        "message": "<SideMenuItem> doesn't accept that prop. Declared props: key, label, icon, onClick."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "Avatar": {
        "replaces": []
